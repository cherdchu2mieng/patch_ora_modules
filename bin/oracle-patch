#!/bin/bash
MODULE=$1
TARGET_PATH=$2
if [ -z "$MODULE" ] || [ -z "$TARGET_PATH" ]; then
    echo "Usage: ./oracle-patch <module> <target_path>"
    exit 1
fi
# Convention: modules/<module>/patch_<short_name>.sh
SHORT_NAME=${MODULE%-js}
SHORT_NAME=${SHORT_NAME%-cli}
SCRIPT_PATH=$(dirname $(realpath "$0"))/../modules/$MODULE/patch_$SHORT_NAME.sh
if [ ! -f "$SCRIPT_PATH" ]; then
    echo "Error: Module script not found at $SCRIPT_PATH"
    exit 1
fi
bash "$SCRIPT_PATH" "$TARGET_PATH" "${@:3}"
